<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F141C">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MsenderM"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="0 files (~0 MB)"
                android:textColor="#00E676"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- Fuzzy Search Bar Input -->
        <EditText
            android:id="@+id/etFuzzySearch"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="#1C2333"
            android:hint="🔍 Search files, apps, videos..."
            android:textColorHint="#607D8B"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select files to send or tap Receive"
            android:textColor="#78909C"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Category Tabs -->
    <HorizontalScrollView
        android:id="@+id/tabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabApps"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="APPS"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2979FF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabImages"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="PHOTOS"
                android:textSize="12sp"
                android:textColor="#ECEFF1"
                android:backgroundTint="#263238"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabVideos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="VIDEOS"
                android:textSize="12sp"
                android:textColor="#ECEFF1"
                android:backgroundTint="#263238"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabAudio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="AUDIO"
                android:textSize="12sp"
                android:textColor="#ECEFF1"
                android:backgroundTint="#263238"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabDocs"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="DOCS"
                android:textSize="12sp"
                android:textColor="#ECEFF1"
                android:backgroundTint="#263238" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Transfer Progress Container -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tabScroll"
        android:orientation="vertical"
        android:background="#1C2333"
        android:padding="12dp"
        android:layout_margin="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCurrentTransferFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sending..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:singleLine="true" />

        <ProgressBar
            android:id="@+id/transferProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTransferSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 MB/s"
                android:textColor="#90CAF9"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTransferPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0%"
                android:textColor="#90CAF9"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Grid View for Images, Videos, Docs -->
    <GridView
        android:id="@+id/gvContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressContainer"
        android:layout_above="@id/bottomBar"
        android:numColumns="4"
        android:verticalSpacing="4dp"
        android:horizontalSpacing="4dp"
        android:padding="6dp"
        android:visibility="visible" />

    <!-- List View for Apps & Audio -->
    <ListView
        android:id="@+id/lvContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressContainer"
        android:layout_above="@id/bottomBar"
        android:divider="#1E2633"
        android:dividerHeight="1dp"
        android:visibility="gone" />

    <!-- Floating Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_send_arrow"
            android:background="@drawable/bg_circle_send"
            android:contentDescription="Send"
            android:layout_marginEnd="20dp" />

        <ImageButton
            android:id="@+id/btnReceive"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_receive_arrow"
            android:background="@drawable/bg_circle_receive"
            android:contentDescription="Receive" />
    </LinearLayout>

</RelativeLayout>

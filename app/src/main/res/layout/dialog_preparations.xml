<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#181D26"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvPrepTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preparations"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- WLAN / Hotspot Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">
        <TextView
            android:id="@+id/iconWlan"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="●"
            android:textSize="18sp"
            android:textColor="#FF5252"
            android:gravity="center" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:id="@+id/tvWlanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open WLAN / Hotspot"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnFixWlan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="OPEN"
            android:textSize="12sp"
            android:backgroundTint="#2979FF" />
    </LinearLayout>

    <!-- Location Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">
        <TextView
            android:id="@+id/iconGps"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="●"
            android:textSize="18sp"
            android:textColor="#FF5252"
            android:gravity="center" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turn on Location (GPS)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnFixGps"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="SETUP"
            android:textSize="12sp"
            android:backgroundTint="#2979FF" />
    </LinearLayout>

    <!-- Nearby / Permissions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">
        <TextView
            android:id="@+id/iconPerm"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="●"
            android:textSize="18sp"
            android:textColor="#FF5252"
            android:gravity="center" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearby Devices &amp; Storage"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnFixPerm"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="ALLOW"
            android:textSize="12sp"
            android:backgroundTint="#2979FF" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPrepNext"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="NEXT"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:backgroundTint="#333D4E"
        android:enabled="false" />

</LinearLayout>
